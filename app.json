{
  "expo": {
    "name": "vupth-partner",
    "slug": "vupth-partner",
    "version": "1.0.0",
    "scheme": "vupth-partner",
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-secure-store"
    ],
    "userInterfaceStyle": "automatic",
    "android": {
      "softwareKeyboardLayoutMode": "pan"
    },
    "androidNavigationBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#F7FAF8"
    }
  }
}
