{
  "expo": {
    "name": "vupth parceiros",
    "slug": "vupth-partner",
    "version": "1.5.0",
    "scheme": "vupth-partner",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/marca/v-notificacao-96.png",
          "color": "#163300"
        }
      ],
      "@sentry/react-native/expo",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Vupth usa suas fotos para você escolher a foto de perfil que os clientes veem.",
          "cameraPermission": "O Vupth usa a câmera para você tirar a foto de perfil que os clientes veem.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Vupth usa a sua localização para registrar onde fica a loja e ela aparecer para os clientes próximos.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.vupth.partner"
    },
    "android": {
      "package": "com.vupth.partner",
      "versionCode": 6,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "googleServicesFile": "./google-services.json"
    },
    "androidNavigationBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF"
    },
    "extra": {
      "eas": {
        "projectId": "b33bdfbe-e533-4b86-a24c-423a62bc07f5"
      }
    },
    "owner": "andrericao",
    "updates": {
      "url": "https://u.expo.dev/b33bdfbe-e533-4b86-a24c-423a62bc07f5"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "backgroundColor": "#FFFFFF",
    "web": {
      "bundler": "metro",
      "output": "single",
      "lang": "pt-BR"
    }
  }
}
