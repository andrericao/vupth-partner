{
  "expo": {
    "name": "vupth parceiros",
    "slug": "vupth-partner",
    "version": "1.1.0",
    "scheme": "vupth-partner",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-secure-store",
      "expo-notifications"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.vupth.partner"
    },
    "android": {
      "package": "com.vupth.partner",
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "runtimeVersion": {
