{
  "name": "vupth-partner",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "EXPO_PUBLIC_BUILD_TIME=$(date -u +%Y-%m-%dT%H:%M:%SZ) expo export --platform web",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@sentry/react-native": "~7.2.0",
    "@stomp/stompjs": "^7.5.0",
    "@tanstack/react-query": "^5.104.5",
    "axios": "^1.17.1",
    "expo": "~54.0.37",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-navigation-bar": "~5.0.10",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-updates": "~29.0.20",
    "lucide-react-native": "^1.61.0",
    "nativewind": "^4.2.7",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.90.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-qrcode-svg": "^6.3.27",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.5.1",
    "tailwindcss": "^3.4.19",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "axios-mock-adapter": "^2.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^58.0.4",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "jscodeshift": "^17.4.0",
    "prettier": "^3.9.10",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|@tanstack/.*|zustand|expo-router|expo-secure-store|expo-font|expo-status-bar|nativewind|react-native-css-interop)"
    ],
    "moduleNameMapper": {
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js",
      "^@lib/(.*)$": "<rootDir>/src/lib/$1",
      "^@store/(.*)$": "<rootDir>/src/store/$1",
      "^@hooks/(.*)$": "<rootDir>/src/hooks/$1",
      "^@components/(.*)$": "<rootDir>/src/components/$1",
      "^@assets/(.*)$": "<rootDir>/src/assets/$1",
      "^@theme/(.*)$": "<rootDir>/src/theme/$1",
      "^@utils/(.*)$": "<rootDir>/src/utils/$1"
    },
    "collectCoverageFrom": [
      "src/lib/**/*.{ts,tsx}",
      "src/store/**/*.{ts,tsx}",
      "src/utils/**/*.{ts,tsx}",
      "src/theme/**/*.{ts,tsx}",
      "src/hooks/useTema.ts",
      "src/hooks/useAplicarTema.ts",
      "src/components/Aparencia.tsx",
      "src/components/comingSoon.ts",
      "src/components/PendingDot.tsx",
      "src/components/ReadinessFaixa.tsx",
      "src/components/QueueOptions.tsx",
      "src/components/BenchIcon.tsx",
      "src/components/FotoRemota.tsx",
      "src/components/FotoEditavel.tsx",
      "src/components/Skeleton.tsx",
      "src/components/ExpedienteCard.tsx",
      "src/components/CommitDoCodigo.tsx",
      "src/components/AvisoLojaSemPonto.tsx",
      "src/components/ExporPosicao.tsx",
      "!src/**/__tests__/**",
      "!src/**/*.d.ts",
      "!src/lib/types.ts",
      "!src/lib/styles.ts",
      "!src/lib/queryClient.ts",
      "!src/utils/productDatas.ts"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "__tests__"
    ],
    "coverageReporters": [
      "text-summary",
      "text",
      "lcov",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 80,
        "functions": 80,
        "lines": 80
      }
    },
    "testPathIgnorePatterns": [
      "<rootDir>/.claude/"
    ]
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "eslint-config-expo"
      ]
    }
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
