{
  "name": "vupth-partner",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@gluestack-style/react": "^1.0.57",
    "@gluestack-ui/config": "^1.1.20",
    "@gluestack-ui/themed": "^1.1.73",
    "@hookform/resolvers": "^3.9.1",
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/react-query": "^5.62.0",
    "@types/react": "~19.1.10",
    "axios": "^1.7.9",
    "expo": "~54.0.36",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-navigation-bar": "~5.0.10",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.19",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.54.2",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.5.1",
    "typescript": "~5.9.2",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "axios-mock-adapter": "^2.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^56.0.4",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "jscodeshift": "^0.15.2",
    "prettier": "^3.3.3",
    "react-native-svg-transformer": "^1.5.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@gluestack-ui/.*|@gluestack-style/.*|@legendapp/.*|@tanstack/.*|zustand|expo-router|expo-secure-store|expo-font|expo-status-bar)"
    ],
    "moduleNameMapper": {
      "^@lib/(.*)$": "<rootDir>/src/lib/$1",
      "^@store/(.*)$": "<rootDir>/src/store/$1",
      "^@hooks/(.*)$": "<rootDir>/src/hooks/$1",
      "^@components/(.*)$": "<rootDir>/src/components/$1",
      "^@assets/(.*)$": "<rootDir>/src/assets/$1",
      "^@theme/(.*)$": "<rootDir>/src/theme/$1",
      "^@utils/(.*)$": "<rootDir>/src/utils/$1"
    },
    "collectCoverageFrom": [
      "src/lib/**/*.{ts,tsx}",
      "src/store/**/*.{ts,tsx}",
      "src/utils/**/*.{ts,tsx}",
      "src/components/comingSoon.ts",
      "src/components/PendingDot.tsx",
      "src/components/ReadinessFaixa.tsx",
      "src/components/ProfessionalStatusControl.tsx",
      "!src/**/__tests__/**",
      "!src/**/*.d.ts",
      "!src/lib/types.ts",
      "!src/lib/styles.ts",
      "!src/lib/queryClient.ts",
      "!src/utils/productDatas.ts"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "__tests__"
    ],
    "coverageReporters": [
      "text-summary",
      "text",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 97,
        "branches": 84,
        "functions": 98,
        "lines": 98
      }
    }
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "eslint-config-expo"
      ]
    }
  }
}
