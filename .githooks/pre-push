#!/usr/bin/env sh
#
# Anti-quebra (pre-push): bloqueia o push se algo estiver quebrado.
# Gate, na ordem: lint -> typecheck -> testes (jest) -> config (expo-doctor).
# Se qualquer passo falhar, o push e' ABORTADO.
#
# Bypass de emergencia (use com consciencia): git push --no-verify
#
set -e

# Node >= 20.19.4 antes de tudo (o do sistema pode ser o 18). Ver o arquivo.
. "$(dirname "$0")/node-certo.sh"

echo "──────────────────────────────────────────────"
echo "[pre-push] 1/4  lint (eslint --max-warnings 0)"
echo "──────────────────────────────────────────────"
npm run --silent lint

echo "──────────────────────────────────────────────"
echo "[pre-push] 2/4  typecheck (tsc --noEmit)"
echo "──────────────────────────────────────────────"
npm run --silent typecheck

echo "──────────────────────────────────────────────"
echo "[pre-push] 3/4  testes + cobertura (jest --coverage)"
echo "──────────────────────────────────────────────"
# --coverage p/ aplicar o mesmo gate de cobertura que o CI (coverageThreshold no
# package.json). Sem isso, uma regressao de cobertura passava aqui e so estourava
# no CI, disparando o auto-rollback. (2026-07-17)
# DEC-22/28: a falha do jest fica em logs/testes/<data>_jest_FALHA.txt (o hook do
# vupth-docs acorda a equipe com ela); verde apaga as falhas antigas do jest. O
# codigo de saida do jest sai por arquivo: o pipe com tee o esconderia.
LOGS=logs/testes
mkdir -p "$LOGS"
SAIDA=$(mktemp)
CODIGO=$(mktemp)
{ npm test -- --ci --coverage 2>&1; echo $? > "$CODIGO"; } | tee "$SAIDA"
RC=$(cat "$CODIGO")
rm -f "$CODIGO"
if [ "$RC" != "0" ]; then
  LOG="$LOGS/$(date +%Y-%m-%d_%H%M%S)_jest_FALHA.txt"
  mv "$SAIDA" "$LOG"
  echo "[pre-push] jest falhou - log em $LOG"
  exit "$RC"
fi
rm -f "$SAIDA" "$LOGS"/*_jest_FALHA.txt

echo "──────────────────────────────────────────────"
echo "[pre-push] 4/4  config (expo-doctor)"
echo "──────────────────────────────────────────────"
npx expo-doctor

echo "──────────────────────────────────────────────"
echo "[pre-push] OK - tudo verde, push liberado"
echo "──────────────────────────────────────────────"
