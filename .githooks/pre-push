#!/usr/bin/env sh
#
# Anti-quebra (pre-push): bloqueia o push se algo estiver quebrado.
# Gate, na ordem: typecheck -> testes (jest) -> config (expo-doctor).
# Se qualquer passo falhar, o push e' ABORTADO.
#
# Bypass de emergencia (use com consciencia): git push --no-verify
#
set -e

echo "──────────────────────────────────────────────"
echo "[pre-push] 1/3  typecheck (tsc --noEmit)"
echo "──────────────────────────────────────────────"
npm run --silent typecheck

echo "──────────────────────────────────────────────"
echo "[pre-push] 2/3  testes (jest)"
echo "──────────────────────────────────────────────"
npm test -- --ci

echo "──────────────────────────────────────────────"
echo "[pre-push] 3/3  config (expo-doctor)"
echo "──────────────────────────────────────────────"
npx expo-doctor

echo "──────────────────────────────────────────────"
echo "[pre-push] OK - tudo verde, push liberado"
echo "──────────────────────────────────────────────"
