tion=../apoio/fechar_aviso.yaml, config=MaestroConfig(appId=${APP_ID}, name=null, tags=[], ext={}, onFlowStart=null, onFlowComplete=null, properties={}), label=12.03 · roda fechar_aviso, optional=false)), MaestroCommand(assertConditionCommand=AssertConditionCommand(condition=Condition(platform=null, visible=ElementSelector(textRegex=__nunca_aparece__, idRegex=null, size=null, below=null, above=null, leftOf=null, rightOf=null, containsChild=null, containsDescendants=null, traits=null, index=null, enabled=null, optional=false, selected=null, checked=null, focused=null, childOf=null, css=null), notVisible=null, scriptCondition=null, label=null), timeout=20000, label=12.03a · espera 10 s o registro do token do push, optional=true)), MaestroCommand(pressKeyCommand=PressKeyCommand(code=HOME, label=12.04 · vai para a tela inicial (app em segundo plano), optional=false)), MaestroCommand(runScriptCommand=RunScriptCommand(script=// Um SEGUNDO profissional pede vinculo a loja do dono pela API do staging — o
// dono recusa na bateria (fluxo critico, DEC-7) e depois o convida.
//
// Tambem provoca o push "Pedido de vinculo" da 12 (push-na-bateria), com outro
// profissional (QUEM).
//
// Entradas (env do runScript): API, EMAIL_DONO, SENHA, TAG e, opcional, QUEM
// ("Recusado" se ausente — uma conta por QUEM)
// Saida: output.PROF_<QUEM> (o nome, como aparece no card; ex.: PROF_RECUSADO)

function pedir(metodo, url, corpo, token) {
  var headers = { "Content-Type": "application/json" };
  if (token) headers["Authorization"] = "Bearer " + token;
  var r = http.request(API + url, { method: metodo, headers: headers, body: corpo ? JSON.stringify(corpo) : (metodo === "GET" || metodo === "DELETE" ? undefined : "{}") });
  if (r.status >= 300) throw new Error(metodo + " " + url + " -> " + r.status + " " + r.body);
  return r.body ? json(r.body) : null;
}

function entrar(email) {
