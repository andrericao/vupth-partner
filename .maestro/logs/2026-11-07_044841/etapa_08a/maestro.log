lector=ElementSelector(textRegex=null, idRegex=login-password, size=null, below=null, above=null, leftOf=null, rightOf=null, containsChild=null, containsDescendants=null, traits=null, index=null, enabled=null, optional=false, selected=null, checked=null, focused=null, childOf=null, css=null), retryIfNoChange=false, waitUntilVisible=false, longPress=false, repeat=null, waitToSettleTimeoutMs=null, relativePoint=null, label=null, optional=false)), MaestroCommand(inputTextCommand=InputTextCommand(text=${SENHA}, label=null, optional=false)), MaestroCommand(hideKeyboardCommand=HideKeyboardCommand()), MaestroCommand(tapOnElementCommand=TapOnElementCommand(selector=ElementSelector(textRegex=null, idRegex=login-submit, size=null, below=null, above=null, leftOf=null, rightOf=null, containsChild=null, containsDescendants=null, traits=null, index=null, enabled=null, optional=false, selected=null, checked=null, focused=null, childOf=null, css=null), retryIfNoChange=false, waitUntilVisible=false, longPress=false, repeat=null, waitToSettleTimeoutMs=null, relativePoint=null, label=null, optional=false))], condition=null, sourceDescription=../apoio/entrar.yaml, config=MaestroConfig(appId=${APP_ID}, name=null, tags=[], ext={}, onFlowStart=null, onFlowComplete=null, properties={}), label=08.01 · roda entrar, optional=false)), MaestroCommand(assertConditionCommand=AssertConditionCommand(condition=Condition(platform=null, visible=ElementSelector(textRegex=${output.LOJA}, idRegex=null, size=null, below=null, above=null, leftOf=null, rightOf=null, containsChild=null, containsDescendants=null, traits=null, index=null, enabled=null, optional=false, selected=null, checked=null, focused=null, childOf=null, css=null), notVisible=null, scriptCondition=null, label=null), timeout=60000, label=08.02 · espera ${output.LOJA}, optional=false)), MaestroCommand(assertConditionCommand=AssertConditionCommand(condition=Condition(platform=null, visible=ElementSelector(textRegex=null, idRegex=compartilhar-no-topo, size=null, below=null, above=null, leftOf=null, rightOf=null, containsChild=null, containsDescendants=null, traits=null, index=null, enabled=null, optional=false, selected=null, checked=null, focused=null, childOf=null, css=null), notVisible=null, scriptCondition=null, label=null), timeout=null, label=08.02a · confere compartilhar-no-topo, optional=false)), MaestroCommand(runFlowCommand=RunFlowCommand(commands=[MaestroCommand(defineVariablesCommand=DefineVariablesCommand(env={NOME=inicio-compartilhar, O_QUE=o icone de compartilhar ao lado da pilula Aberta/Fechada, no topo do Inicio do dono}, label=null, optional=false)), MaestroCommand(applyConfigurationCommand=ApplyConfigurationCommand(config=MaestroConfig(appId=${APP_ID}, name=null, tags=[], ext={}, onFlowStart=null, onFlowComplete=null, properties={}), label=null, optional=false)), MaestroCommand(takeScreenshotCommand=TakeScreenshotCommand(path=para-o-andre_${NOME}, cropOn=null, label=null, optional=false)), MaestroCommand(evalScriptCommand=EvalScriptCommand(scriptString=${console.log('PARA-O-ANDRE: ' + NOME + ' — ' + O_QUE)}, label=null, optional=false))], condition=null, sourceDescription=../apoio/para_o_andre.yaml, config=MaestroConfig(appId=${APP_ID}, name=null, tags=[], ext={}, onFlowStart=null, onFlowComplete=null, properties={}), label=08.02b · print para o Andre (inicio-compartilhar), optional=false)), MaestroCommand(runScriptCommand=RunScriptCommand(script=// estrela-no-card (PAR-4, DEC-184): o cliente da rodada avalia pela API o
// atendimento que o profissional finalizou na 05a, para o card do dono mostrar
// a estrela e a media no print para o Andre. Nunca derruba a etapa: sem
// atendimento FINISHED (etapa avulsa) ou ja avaliado, so nao avalia.
//
// Entradas (env do runScript): API, SENHA, TAG, NOTA (1 a 5; padrao 5)
// Saida: output.AVALIOU ("1" avaliou agora ou ja estava avaliado; "0" nao achou)

function pedir(metodo, url, corpo, token) {
  var headers = { "Content-Type": "application/json" };
  if (token) headers["Authorization"] = "Bearer " + token;
  return http.request(API + url, { method: metodo, headers: headers, body: corpo ? JSON.stringify(corpo) : undefined });
}

output.AVALIOU = "0";
var login = pedir("POST", "/auth/login", { email: "client_" + TAG + "_1@teste.com", password: SENHA });
if (login.status < 300) {
  var token = json(login.body).tokens.access_token;
  var lista = pedir("GET", "/attendances/client/me?status=FINISHED", null, token);
  var itens = lista.status < 300 && lista.body ? json(lista.body) : [];
  var nota = typeof NOTA === "undefined" || !NOTA ? 5 : parseInt(NOTA, 10);
  for (var i = 0; i < itens.length && output.AVALIOU === "0"; i++) {
    var r = pedir("POST", "/attendances/" + itens[i].id + "/rating", { score: nota, comment: "bateria " + TAG }, token);
    // 201 avaliou; 409 ja tinha a nota desta rodada
    if (r.status === 201 || r.status === 409) output.AVALIOU = "1";
  }
