02:35:35.348 [ INFO] maestro.cli.runner.MaestroCommandRunner.runCommands$lambda$0: 03.14 · script vinculo_para_recusar RUNNING
02:35:35.360 [ INFO] maestro.cli.runner.MaestroCommandRunner.runCommands$lambda$11: 03.14 · script vinculo_para_recusar metadata CommandMetadata(numberOfRuns=null, evaluatedCommand=MaestroCommand(runScriptCommand=RunScriptCommand(script=// Um SEGUNDO profissional pede vinculo a loja do dono pela API do staging — o
// dono recusa na bateria (fluxo critico, DEC-7) e depois o convida.
//
// Tambem provoca o push "Pedido de vinculo" da 12 (push-na-bateria), com outro
// profissional (QUEM).
//
// Entradas (env do runScript): API, EMAIL_DONO, SENHA, TAG e, opcional, QUEM
// ("Recusado" se ausente — uma conta por QUEM)
// Saida: output.PROF_<QUEM> (o nome, como aparece no card; ex.: PROF_RECUSADO)

function pedir(metodo, url, corpo, token) {
  var headers = { "Content-Type": "application/json" };
  if (token) headers["Authorization"] = "Bearer " + token;
  var r = http.request(API + url, { method: metodo, headers: headers, body: corpo ? JSON.stringify(corpo) : (metodo === "GET" || metodo === "DELETE" ? undefined : "{}") });
  if (r.status >= 300) throw new Error(metodo + " " + url + " -> " + r.status + " " + r.body);
  return r.body ? json(r.body) : null;
}

function entrar(email) {
  return pedir("POST", "/auth/login", { email: email, password: SENHA }).tokens.access_token;
}

var lojas = pedir("GET", "/establishment/mine", null, entrar(EMAIL_DONO));
if (!lojas || lojas.length === 0) throw new Error("o dono nao tem loja");

var quem = typeof QUEM === "undefined" || !QUEM ? "Recusado" : String(QUEM);
var nome = quem + TAG;
var email = "prof_m" + TAG + "_" + quem.toLowerCase() + "@teste.com";
pedir("POST", "/auth/register", { email: email, password: SENHA });
pedir("POST", "/professional/register", { name: nome, specialty: "NAIL_TECH" }, entrar(email));
// Login de novo: o token tem de carregar o papel PROFESSIONAL recem-criado.
// O PEDIDO (PENDING), como o app faz em establishment-detail — o
// /professional/affiliate vincula direto e nao deixa nada para o dono recusar.
pedir("POST", "/professional/me/affiliations", { establishmentId: lojas[0].id }, entrar(email));
output["PROF_" + quem.toUpperCase()] = nome;
, env={EMAIL_DONO=prop_m020056@teste.com, TAG=020056}, sourceDescription=/tmp/tmp.EVSn9WpQJK/scripts/vinculo_para_recusar.js, condition=null, label=03.14 · script vinculo_para_recusar, optional=false)), logMessages=[], insight=Insight(message=, level=NONE), aiReasoning=null, labeledCommand=null)
