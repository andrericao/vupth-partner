17:17:26.153 [ INFO] maestro.cli.runner.MaestroCommandRunner.runCommands$lambda$11: 05.00 · roda 05a_atende_a_fila metadata CommandMetadata(numberOfRuns=null, evaluatedCommand=MaestroCommand(runFlowCommand=RunFlowCommand(commands=[MaestroCommand(applyConfigurationCommand=ApplyConfigurationCommand(config=MaestroConfig(appId=${APP_ID}, name=null, tags=[], ext={}, onFlowStart=null, onFlowComplete=null, properties={}), label=null, optional=false)), MaestroCommand(runScriptCommand=RunScriptCommand(script=// Poe clientes na fila do profissional pela API do staging — o papel do app do
// client, para a bateria nao depender dele.
//
// Entradas (env do runScript): API, EMAIL_PROF, SENHA, TAG, QTD e, opcional,
// PELO_ANDRE ("1" na bateria supervisionada com os dois usuarios, DEC-15): o
// ULTIMO cliente so ganha a conta e o nome — quem entra na fila e o Andre,
// pelo app Client, no segundo celular.
// Saidas: output.CLIENTE1..N (primeiro nome, como aparece no card)

function pedir(metodo, url, corpo, token) {
  var headers = { "Content-Type": "application/json" };
  if (token) headers["Authorization"] = "Bearer " + token;
  var r = http.request(API + url, { method: metodo, headers: headers, body: corpo ? JSON.stringify(corpo) : (metodo === "GET" || metodo === "DELETE" ? undefined : "{}") });
  if (r.status >= 300) throw new Error(metodo + " " + url + " -> " + r.status + " " + r.body);
  return r.body ? json(r.body) : null;
}

function entrar(email) {
  return pedir("POST", "/auth/login", { email: email, password: SENHA }).tokens.access_token;
}

var tokenProf = entrar(EMAIL_PROF);
var prof = pedir("GET", "/professional/me", null, tokenProf);
var servicos = pedir("GET", "/professional/" + prof.id + "/service-items", null, tokenProf);
if (!servicos || servicos.length === 0) throw new Error("o profissional nao tem servico");

var qtd = parseInt(QTD, 10);
var peloAndre = typeof PELO_ANDRE === "undefined" ? "" : String(PELO_ANDRE);
for (var i = 1; i <= qtd; i++) {
  var nome = "Cliente" + i + "x" + TAG;
  var email = "client_" + TAG + "_" + i + "@teste.com";
  pedir("POST", "/auth/register", { email: email, password: SENHA });
  var token = entrar(email);
  pedir("PATCH", "/profile/general-infos", { first_name: nome }, token);
  output["CLIENTE" + i] = nome;
  if (i === qtd && peloAndre === "1") break;
  pedir("POST", "/attendances", {
    professionalId: prof.id,
    establishmentId: prof.establishment_id,
    serviceItemIds: [servicos[0].id],
    scheduledTime: new Date().toISOString()
  }, token);
}
, env={EMAIL_PROF=${output.EMAIL_PROF}, TAG=${output.TAG}, QTD=2, PELO_ANDRE=${typeof SUPERVISAO !== 'undefined' && SUPERVISAO == '2' ? '1' : '0'}}, sourceDescription=/tmp/tmp.ODGx96iURI/scripts/clientes_na_fila.js, condition=null, label=05.01 · script clientes_na_fila, optional=false)), MaestroCommand(tapOnElementCommand=TapOnElementCommand(selector=ElementSelector(textRegex=null, idRegex=aba-fila, size=null, below=null, above=null, leftOf=null, rightOf=null, containsChild=null, containsDescendants=null, traits=null, index=null, enabled=null, optional=false, selected=null, checked=null, focused=null, childOf=null, css=null), retryIfNoChange=false, waitUntilVisible=false, longPress=false, repeat=null, waitToSettleTimeoutMs=null, relativePoint=null, label=05.02 · toca em aba-fila, optional=false)), MaestroCommand(assertConditionCommand=AssertConditionCommand(condition=Condition(platform=null, visible=ElementSelector(textRegex=null, idRegex=logo-v, size=null, below=null, above=null, leftOf=null, rightOf=null, containsChild=null, containsDescendants=null, traits=null, index=null, enabled=null, optional=false, selected=null, checked=null, focused=null, childOf=null, css=null), notVisible=null, scriptCondition=null, label=null), timeout=null, label=05.02a · logo-no-menu · o V no topo da Fila, optional=false)), MaestroCommand(runFlowCommand=RunFlowCommand(commands=[MaestroCommand(assertConditionCommand=AssertConditionCommand(condition=Condition(platform=null, visible=ElementSelector(textRegex=${output.CLIENTE2}, idRegex=null, size=null, below=null, above=null, leftOf=null, rightOf=null, containsChild=null, containsDescendants=null, traits=null, index=null, enabled=null, optional=false, selected=null, checked=null, focused=null, childOf=null, css=null), notVisible=null, scriptCondition=null, label=null), timeout=600000, label=05.0A · espera o Andre entrar na fila (ate 5 min), optional=false))], condition=Condition(platform=null, visible=null, notVisible=null, scriptConditi