Command(tapOnElementCommand=TapOnElementCommand(selector=ElementSelector(textRegex=null, idRegex=dialogo-botao-0, size=null, below=null, above=null, leftOf=null, rightOf=null, containsChild=null, containsDescendants=null, traits=null, index=null, enabled=null, optional=false, selected=null, checked=null, focused=null, childOf=null, css=null), retryIfNoChange=false, waitUntilVisible=false, longPress=false, repeat=null, waitToSettleTimeoutMs=null, relativePoint=null, label=null, optional=false))], condition=Condition(platform=null, visible=ElementSelector(textRegex=null, idRegex=dialogo-botao-0, size=null, below=null, above=null, leftOf=null, rightOf=null, containsChild=null, containsDescendants=null, traits=null, index=null, enabled=null, optional=false, selected=null, checked=null, focused=null, childOf=null, css=null), notVisible=null, scriptCondition=null, label=null), sourceDescription=null, config=null, label=null, optional=false)), MaestroCommand(runFlowCommand=RunFlowCommand(commands=[MaestroCommand(tapOnElementCommand=TapOnElementCommand(selector=ElementSelector(textRegex=null, idRegex=android:id/button1, size=null, below=null, above=null, leftOf=null, rightOf=null, containsChild=null, containsDescendants=null, traits=null, index=null, enabled=null, optional=false, selected=null, checked=null, focused=null, childOf=null, css=null), retryIfNoChange=false, waitUntilVisible=false, longPress=false, repeat=null, waitToSettleTimeoutMs=null, relativePoint=null, label=null, optional=false))], condition=Condition(platform=null, visible=ElementSelector(textRegex=null, idRegex=android:id/button1, size=null, below=null, above=null, leftOf=null, rightOf=null, containsChild=null, containsDescendants=null, traits=null, index=null, enabled=null, optional=false, selected=null, checked=null, focused=null, childOf=null, css=null), notVisible=null, scriptCondition=null, label=null), sourceDescription=null, config=null, label=null, optional=false))], condition=null, sourceDescription=../apoio/fechar_aviso.yaml, config=MaestroConfig(appId=${APP_ID}, name=null, tags=[], ext={}, onFlowStart=null, onFlowComplete=null, properties={}), label=12.03 · roda fechar_aviso, optional=false)), MaestroCommand(assertConditionCommand=AssertConditionCommand(condition=Condition(platform=null, visible=ElementSelector(textRegex=__nunca_aparece__, idRegex=null, size=null, below=null, above=null, leftOf=null, rightOf=null, containsChild=null, containsDescendants=null, traits=null, index=null, enabled=null, optional=false, selected=null, checked=null, focused=null, childOf=null, css=null), notVisible=null, scriptCondition=null, label=null), timeout=10000, label=12.03a · espera 10 s o registro do token do push, optional=true)), MaestroCommand(pressKeyCommand=PressKeyCommand(code=HOME, label=12.04 · vai para a tela inicial (app em segundo plano), optional=false)), MaestroCommand(runScriptCommand=RunScriptCommand(script=// Um SEGUNDO profissional pede vinculo a loja do dono pela API do staging — o
// dono recusa na bateria (fluxo critico, DEC-7) e depois o convida.
//
// Tambem provoca o push "Pedido de vinculo" da 12 (push-na-bateria), com outro
// profissional (QUEM).
//
// Entradas (env do runScript): API, EMAIL_DONO, SENHA, TAG e, opcional, QUEM
// ("Recusado" se ausente — uma conta por QUEM)
// Saida: output.PROF_<QUEM> (o nome, como aparece no card; ex.: PROF_RECUSADO)

function pedir(metodo, url, corpo, token) {
  var headers = { "Content-Type": "application/json" };
  if (token) headers["Authorization"] = "Bearer " + token;
  var r = http.request(API + url, { method: metodo, headers: headers, body: corpo ? JSON.stringify(corpo) : (metodo === "GET" || metodo === "DELETE" ? undefined : "{}") });
  if (r.status >= 300) throw new Error(metodo + " " + url + " -> " + r.status + " " + r.body);
  return r.body ? json(r.body) : null;
}

function entrar(email) {
  return pedir("POST", "/auth/login", { email: email, password: SENHA }).tokens.access_token;
}

var lojas = pedir("GET", "/establishment/mine", null, entrar(EMAIL_DONO));
if (!lojas || lojas.length === 0) throw new Error("o dono nao tem loja");

var quem = typeof QUEM === "undefined" || !QUEM ? "Recusado" : String(QUEM);
var nome = quem + TAG;
var email = "prof_m" + TAG + "_" + quem.toLowerCase() + "@teste.com";
pedir("POST", "/auth/register", { email: email, password: SENHA });
pedir("POST", "/professional/register", { name: nome, specialty: "NAIL_TECH" }, entrar(email));
// Login de novo: o token tem de carregar o papel PROFESSIONAL recem-criado.
// O PEDIDO (PENDING), como o app faz em establishment-detail — o
// /professional/affiliate vincula direto e nao deixa nada para o dono recusar.
